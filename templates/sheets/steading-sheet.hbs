                      <option value="defenses" {{#if (eq this.system.stat "defenses")}}selected{{/if}}>Defenses</option>
                    </select>

                    <button class="move-roll" type="button">Roll</button>
                  {{else}}
                    <button class="move-roll" type="button">Share</button>
                  {{/if}}
                </div>
              </div>
          {{/each}}
