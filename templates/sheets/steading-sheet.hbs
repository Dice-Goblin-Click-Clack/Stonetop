                    <button class="move-delete icon-button" type="button" title="Delete">
                      <img src="systems/stonetop/assets/icons/delete-icon.png">
                    </button>
                  </div>
                </div>

                <div class="move-card-body">
                  <div class="move-description">
                    {{{this.descriptionHtml}}}
                  </div>

                  {{#if this.canRoll}}
                    <label>Roll Stat</label>
                    <select class="move-stat-select">
                      <option value="">No Stat / +Nothing</option>
                      <option value="fortunes" {{#if (eq this.system.stat "fortunes")}}selected{{/if}}>Fortunes</option>
                      <option value="surplus" {{#if (eq this.system.stat "surplus")}}selected{{/if}}>Surplus</option>
                      <option value="size" {{#if (eq this.system.stat "size")}}selected{{/if}}>Size</option>
