                  <div class="move-header-left">
                    <img class="move-item-icon" src="{{this.img}}" alt="{{this.name}}">
                    <button class="move-title" type="button">{{this.name}}</button>
                  </div>

                  {{#if this.system.showPips}}
                    <div class="move-pips">
                      {{#each this.pipSlots}}
                        <input
                          type="checkbox"
                          class="circle-check move-pip"
                          data-pip="{{this.key}}"
                          {{#if this.checked}}checked{{/if}}
                        >
                      {{/each}}
                    </div>
                  {{/if}}

                  <div class="move-card-actions">
                    <button class="move-edit icon-button" type="button" title="Edit">
