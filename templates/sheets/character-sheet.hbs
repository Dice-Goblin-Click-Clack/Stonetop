<form class="{{cssClass}}" autocomplete="off">

  <header class="sheet-header character-top textured-header">

  <div class="header-main">

    <div class="name-frame">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Charactername">
    </div>

    <div class="stat-instruction">
      Assign these scores: +2, +1, +1, +0, +0, -1. When a debility is marked, you roll with disadvantage.
    </div>

    <div class="textured-stats-row">

      <div class="textured-stat">
        <button class="stat-roll" type="button" data-stat="str" data-label="Strength">Strength</button>
        <input name="system.stats.str" type="text" value="{{system.stats.str}}">
        <div class="stat-short">(STR)</div>
      </div>

      <div class="textured-stat">
        <button class="stat-roll" type="button" data-stat="dex" data-label="Dexterity">Dexterity</button>
        <input name="system.stats.dex" type="text" value="{{system.stats.dex}}">
        <div class="stat-short">(DEX)</div>
      </div>

      <div class="textured-stat">
        <button class="stat-roll" type="button" data-stat="int" data-label="Intelligence">Intelligence</button>
        <input name="system.stats.int" type="text" value="{{system.stats.int}}">
        <div class="stat-short">(INT)</div>
      </div>

      <div class="textured-stat">
        <button class="stat-roll" type="button" data-stat="wis" data-label="Wisdom">Wisdom</button>
        <input name="system.stats.wis" type="text" value="{{system.stats.wis}}">
        <div class="stat-short">(WIS)</div>
      </div>

      <div class="textured-stat">
        <button class="stat-roll" type="button" data-stat="con" data-label="Constitution">Constitution</button>
        <input name="system.stats.con" type="text" value="{{system.stats.con}}">
        <div class="stat-short">(CON)</div>
      </div>

      <div class="textured-stat">
        <button class="stat-roll" type="button" data-stat="cha" data-label="Charisma">Charisma</button>
        <input name="system.stats.cha" type="text" value="{{system.stats.cha}}">
        <div class="stat-short">(CHA)</div>
      </div>

    </div>

    <div class="debility-row">

      <label class="debility-control debility-weakened">
        <span class="debility-divider"></span>
        <input class="circle-check" type="checkbox" name="system.debilities.weakened" {{checked system.debilities.weakened}}>
        <span>weakened</span>
      </label>

      <label class="debility-control debility-dazed">
        <span class="debility-divider"></span>
        <input class="circle-check" type="checkbox" name="system.debilities.dazed" {{checked system.debilities.dazed}}>
        <span>dazed</span>
      </label>

      <label class="debility-control debility-miserable">
        <span class="debility-divider"></span>
        <input class="circle-check" type="checkbox" name="system.debilities.miserable" {{checked system.debilities.miserable}}>
        <span>miserable</span>
      </label>

    </div>

    <div class="resource-row">

      <div class="textured-resource small-resource">
        <button class="damage-roll" type="button">Damage</button>
        <input name="system.damage" type="text" value="{{system.damage}}">
      </div>

      <div class="textured-resource wide-resource">
        <div class="resource-label">HP</div>
        <div class="split-field">
          <input name="system.hp.value" type="number" value="{{system.hp.value}}">
          <span>/</span>
          <input name="system.hp.max" type="number" value="{{system.hp.max}}">
        </div>
      </div>

      <div class="textured-resource small-resource">
        <div class="resource-label">Armor</div>
        <input name="system.armor" type="number" value="{{system.armor}}">
      </div>

      <div class="textured-resource wide-resource">
        <div class="resource-label">XP</div>
        <div class="split-field">
          <input name="system.xp.value" type="number" value="{{system.xp.value}}">
          <span>/</span>
          <input type="number" value="{{nextLevelXP}}" disabled>
        </div>
      </div>

      <div class="textured-resource small-resource">
        <div class="resource-label">Level</div>
        <input name="system.level" type="number" value="{{system.level}}">
      </div>

    </div>

  </div>

  <div class="portrait-frame">
    <img src="{{actorImg}}" alt="{{actor.name}}">
  </div>

</header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item active" data-tab="playbook">Playbook</a>
    <a class="item" data-tab="moves">Moves</a>
    <a class="item" data-tab="inventory">Inventory</a>
    <a class="item" data-tab="arcana">Arcana</a>
    <a class="item" data-tab="notes">Notes</a>

    {{#each insertTabs}}
      <a class="item" data-tab="{{this.tabId}}">{{this.label}}</a>
    {{/each}}
  </nav>

  <section class="sheet-body">

    
<div class="tab active" data-group="primary" data-tab="playbook">

  <div class="playbook-tab-layout">

    <section class="playbook-column">

      <div class="playbook-panel">
        <div class="playbook-panel-header">
          <h2>Playbook</h2>

          {{#if playbookItem}}
            <div class="playbook-panel-actions">
              <button class="embedded-item-edit icon-button" type="button" data-item-id="{{playbookItem.id}}" title="Edit Playbook">
                <img src="systems/stonetop/assets/icons/edit-icon.png">
              </button>

              <button class="embedded-item-delete icon-button" type="button" data-item-id="{{playbookItem.id}}" title="Delete Playbook">
                <img src="systems/stonetop/assets/icons/delete-icon.png">
              </button>
            </div>
          {{/if}}
        </div>

        <div class="playbook-panel-divider"></div>

        <div class="playbook-panel-body">

          {{#if playbookItem}}

            <h3>{{playbookItem.name}}</h3>

            <div class="playbook-text">
              {{{playbookItem.descriptionHtml}}}
            </div>

            <div class="builder-action-row" style="display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center;">
              <button class="builder-apply-button" type="button" data-source-item-id="{{playbookItem.id}}">Apply Builder</button>
              {{#if playbookItem.builderApplied}}<span class="builder-row-check">✓</span>{{/if}}
            </div>

            {{#if playbookItem.builderChoiceGroups.length}}
              <div class="builder-choice-list">
                {{#each playbookItem.builderChoiceGroups}}
                  <div class="builder-choice-row" style="display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center;">
                    <button
                      class="builder-choice-button"
                      type="button"
                      data-choice-key="{{this.choiceKey}}"
                      data-source-item-id="{{this.sourceItemId}}"
                      data-group-id="{{this.id}}"
                    >
                      {{this.label}}
                    </button>

                    <span class="builder-row-check">{{this.checkmark}}</span>
                  </div>

                  {{#if this.selectedName}}
                    <div class="builder-choice-selected">{{this.selectedName}}</div>
                  {{/if}}
                {{/each}}
              </div>
            {{/if}}

          {{else}}

            <p>Drop a Playbook item here.</p>

          {{/if}}

        </div>
      </div>

      <div class="playbook-panel">
        <div class="playbook-panel-header">
          <h2>Background</h2>

          {{#if backgroundItem}}
            <div class="playbook-panel-actions">
              <button class="embedded-item-edit icon-button" type="button" data-item-id="{{backgroundItem.id}}" title="Edit Background">
                <img src="systems/stonetop/assets/icons/edit-icon.png">
              </button>

              <button class="embedded-item-delete icon-button" type="button" data-item-id="{{backgroundItem.id}}" title="Delete Background">
                <img src="systems/stonetop/assets/icons/delete-icon.png">
              </button>
            </div>
          {{/if}}
        </div>

        <div class="playbook-panel-divider"></div>

        <div class="playbook-panel-body">

          {{#if backgroundItem}}

            <h3>{{backgroundItem.name}}</h3>

            <div class="playbook-text">
              {{{backgroundItem.descriptionHtml}}}
            </div>

            <div class="builder-action-row" style="display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center;">
              <button class="builder-apply-button" type="button" data-source-item-id="{{backgroundItem.id}}">Apply Builder</button>
              {{#if backgroundItem.builderApplied}}<span class="builder-row-check">✓</span>{{/if}}
            </div>

            {{#if backgroundItem.builderChoiceGroups.length}}
              <div class="builder-choice-list">
                {{#each backgroundItem.builderChoiceGroups}}
                  <div class="builder-choice-row" style="display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center;">
                    <button
                      class="builder-choice-button"
                      type="button"
                      data-choice-key="{{this.choiceKey}}"
                      data-source-item-id="{{this.sourceItemId}}"
                      data-group-id="{{this.id}}"
                    >
                      {{this.label}}
                    </button>

                    <span class="builder-row-check">{{this.checkmark}}</span>
                  </div>

                  {{#if this.selectedName}}
                    <div class="builder-choice-selected">{{this.selectedName}}</div>
                  {{/if}}
                {{/each}}
              </div>
            {{/if}}

          {{else}}

            <p>Drop a Background item here.</p>

          {{/if}}

        </div>
      </div>

    </section>

    <div class="playbook-divider"></div>

    <section class="playbook-column">

      {{#each profilePanels}}

      <div class="playbook-panel">

        <div class="playbook-panel-header">
          <h2>{{this.label}}</h2>

          {{#if this.item}}
            <div class="playbook-panel-actions">
              <button class="embedded-item-edit icon-button" type="button" data-item-id="{{this.item.id}}" title="Edit {{this.label}}">
                <img src="systems/stonetop/assets/icons/edit-icon.png">
              </button>

              <button class="embedded-item-delete icon-button" type="button" data-item-id="{{this.item.id}}" title="Delete {{this.label}}">
                <img src="systems/stonetop/assets/icons/delete-icon.png">
              </button>
            </div>
          {{/if}}
        </div>

        <div class="playbook-panel-divider"></div>

        <div class="playbook-panel-body">

          {{#if this.item}}

            <div class="playbook-text profile-text-rendered" data-item-id="{{this.item.id}}">
              {{{this.item.textHtml}}}
            </div>

          {{else}}

            <p>Drop a Profile Text item here.</p>

          {{/if}}

        </div>

      </div>

      {{/each}}

    </section>

  </div>

</div>

<div class="tab" data-group="primary" data-tab="moves">


      <h2>Moves</h2>

      <div class="moves-layout">

        <div class="moves-column moves-column-left">
          {{#each moveCategories.left}}
            <section class="move-category {{#unless this.expanded}}category-closed{{/unless}}" data-category="{{this.key}}">

              <button class="move-category-header" type="button" data-category="{{this.key}}">
                <span class="move-category-title">{{this.label}}</span>
                <span class="move-category-toggle">▾</span>
              </button>

              <div class="move-category-body" data-category="{{this.key}}">
                {{#each this.moves}}
                  <div class="move-card" data-item-id="{{this.id}}">

                    <div class="move-card-header">

                      <div class="move-header-left">
                        <img class="move-item-icon" src="{{this.img}}" alt="{{this.name}}">

                        <button class="move-title" type="button">
                          {{this.name}}
                        </button>
                      </div>

                      {{#if this.system.showPips}}
                        <div class="move-pips">
                          {{#each this.pipSlots}}
                            <input
                              type="checkbox"
                              class="circle-check move-pip"
                              data-pip="{{this.key}}"
                              {{#if this.checked}}checked{{/if}}
                            >
                          {{/each}}
                        </div>
                      {{/if}}

                      <div class="move-card-actions">

                        <button class="move-edit insert-move-edit icon-button" type="button" title="Edit">
                          <img src="systems/stonetop/assets/icons/edit-icon.png">
                        </button>

                        <button class="move-delete insert-move-delete icon-button" type="button" title="Delete">
                          <img src="systems/stonetop/assets/icons/delete-icon.png">
                        </button>

                      </div>

                    </div>

                    <div class="move-card-body">

                      <div class="move-description">
                        {{{this.descriptionHtml}}}
                      </div>

                      {{#if this.canRoll}}

                        <label>Roll Stat</label>

                        <select class="move-stat-select insert-move-stat-select">

                          <option value="">No Stat / +Nothing</option>

                          <option value="str" {{#if (eq this.system.stat "str")}}selected{{/if}}>STR</option>
                          <option value="dex" {{#if (eq this.system.stat "dex")}}selected{{/if}}>DEX</option>
                          <option value="con" {{#if (eq this.system.stat "con")}}selected{{/if}}>CON</option>
                          <option value="int" {{#if (eq this.system.stat "int")}}selected{{/if}}>INT</option>
                          <option value="wis" {{#if (eq this.system.stat "wis")}}selected{{/if}}>WIS</option>
                          <option value="cha" {{#if (eq this.system.stat "cha")}}selected{{/if}}>CHA</option>

                        </select>

                        <button class="move-roll" type="button">
                          Roll
                        </button>

                      {{else}}

                        <button class="move-roll" type="button">
                          Share
                        </button>

                      {{/if}}

                    </div>

                  </div>
                {{/each}}
              </div>

            </section>
          {{/each}}
        </div>

        <div class="moves-divider" aria-hidden="true"></div>

        <div class="moves-column moves-column-right">
          {{#each moveCategories.right}}
            <section class="move-category {{#unless this.expanded}}category-closed{{/unless}}" data-category="{{this.key}}">

              <button class="move-category-header" type="button" data-category="{{this.key}}">
                <span class="move-category-title">{{this.label}}</span>
                <span class="move-category-toggle">▾</span>
              </button>

              <div class="move-category-body" data-category="{{this.key}}">
                {{#each this.moves}}
                  <div class="move-card" data-item-id="{{this.id}}">

                    <div class="move-card-header">

                      <div class="move-header-left">
                        <img class="move-item-icon" src="{{this.img}}" alt="{{this.name}}">

                        <button class="move-title" type="button">
                          {{this.name}}
                        </button>
                      </div>

                      {{#if this.system.showPips}}
                        <div class="move-pips">
                          {{#each this.pipSlots}}
                            <input
                              type="checkbox"
                              class="circle-check move-pip"
                              data-pip="{{this.key}}"
                              {{#if this.checked}}checked{{/if}}
                            >
                          {{/each}}
                        </div>
                      {{/if}}

                      <div class="move-card-actions">

                        <button class="move-edit insert-move-edit icon-button" type="button" title="Edit">
                          <img src="systems/stonetop/assets/icons/edit-icon.png">
                        </button>

                        <button class="move-delete insert-move-delete icon-button" type="button" title="Delete">
                          <img src="systems/stonetop/assets/icons/delete-icon.png">
                        </button>

                      </div>

                    </div>

                    <div class="move-card-body">

                      <div class="move-description">
                        {{{this.descriptionHtml}}}
                      </div>

                      {{#if this.canRoll}}

                        <label>Roll Stat</label>

                        <select class="move-stat-select insert-move-stat-select">

                          <option value="">No Stat / +Nothing</option>

                          <option value="str" {{#if (eq this.system.stat "str")}}selected{{/if}}>STR</option>
                          <option value="dex" {{#if (eq this.system.stat "dex")}}selected{{/if}}>DEX</option>
                          <option value="con" {{#if (eq this.system.stat "con")}}selected{{/if}}>CON</option>
                          <option value="int" {{#if (eq this.system.stat "int")}}selected{{/if}}>INT</option>
                          <option value="wis" {{#if (eq this.system.stat "wis")}}selected{{/if}}>WIS</option>
                          <option value="cha" {{#if (eq this.system.stat "cha")}}selected{{/if}}>CHA</option>

                        </select>

                        <button class="move-roll" type="button">
                          Roll
                        </button>

                      {{else}}

                        <button class="move-roll" type="button">
                          Share
                        </button>

                      {{/if}}

                    </div>

                  </div>
                {{/each}}
              </div>

            </section>
          {{/each}}
        </div>

      </div>

    </div>

    <div class="tab" data-group="primary" data-tab="inventory">

      <div class="inventory-sheet">

        <div class="inventory-main">

          <p>When you <strong>Outfit</strong>, mark a number of below, on specific items or Undefined.</p>

          <p>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.lightLoad" {{checked system.inventoryChecks.lightLoad}}>
            For a <strong>light load</strong> <em>(quick & quiet)</em>, mark up to 3 ◆
          </p>

          <p>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.normalLoad" {{checked system.inventoryChecks.normalLoad}}>
            For a <strong>normal load</strong>, mark 4-6 ◆
          </p>

          <p>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.heavyLoad" {{checked system.inventoryChecks.heavyLoad}}>
            For a <strong>heavy load</strong> <em>(noisy, slow, hot, quick to tire)</em>, mark 7-9 ◆
          </p>

          <hr>

          <h3>Undefined</h3>

          <div class="check-row diamond-row">
            <input type="checkbox" name="system.inventoryChecks.undefined1" {{checked system.inventoryChecks.undefined1}}>
            <input type="checkbox" name="system.inventoryChecks.undefined2" {{checked system.inventoryChecks.undefined2}}>
            <input type="checkbox" name="system.inventoryChecks.undefined3" {{checked system.inventoryChecks.undefined3}}>
            <input type="checkbox" name="system.inventoryChecks.undefined4" {{checked system.inventoryChecks.undefined4}}>
            <input type="checkbox" name="system.inventoryChecks.undefined5" {{checked system.inventoryChecks.undefined5}}>
            <input type="checkbox" name="system.inventoryChecks.undefined6" {{checked system.inventoryChecks.undefined6}}>
            <input type="checkbox" name="system.inventoryChecks.undefined7" {{checked system.inventoryChecks.undefined7}}>
            <input type="checkbox" name="system.inventoryChecks.undefined8" {{checked system.inventoryChecks.undefined8}}>
            <input type="checkbox" name="system.inventoryChecks.undefined9" {{checked system.inventoryChecks.undefined9}}>
          </div>

          <p>When you <strong>Have What You Need</strong>, move ◆ from here to below.</p>

          <hr>

          <label class="inventory-line diamond-check">
            <input type="checkbox" name="system.inventoryChecks.supplies" {{checked system.inventoryChecks.supplies}}>
            Supplies (4+Prosperity uses
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.suppliesUse1" {{checked system.inventoryChecks.suppliesUse1}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.suppliesUse2" {{checked system.inventoryChecks.suppliesUse2}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.suppliesUse3" {{checked system.inventoryChecks.suppliesUse3}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.suppliesUse4" {{checked system.inventoryChecks.suppliesUse4}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.suppliesUse5" {{checked system.inventoryChecks.suppliesUse5}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.suppliesUse6" {{checked system.inventoryChecks.suppliesUse6}}>)
          </label>

          <label class="inventory-line diamond-check">
            <input type="checkbox" name="system.inventoryChecks.moreSupplies" {{checked system.inventoryChecks.moreSupplies}}>
            More supplies (4+Prosperity uses
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.moreSuppliesUse1" {{checked system.inventoryChecks.moreSuppliesUse1}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.moreSuppliesUse2" {{checked system.inventoryChecks.moreSuppliesUse2}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.moreSuppliesUse3" {{checked system.inventoryChecks.moreSuppliesUse3}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.moreSuppliesUse4" {{checked system.inventoryChecks.moreSuppliesUse4}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.moreSuppliesUse5" {{checked system.inventoryChecks.moreSuppliesUse5}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.moreSuppliesUse6" {{checked system.inventoryChecks.moreSuppliesUse6}}>)
          </label>

          <label class="inventory-line diamond-check">
            <input type="checkbox" name="system.inventoryChecks.evenMoreSupplies" {{checked system.inventoryChecks.evenMoreSupplies}}>
            Even more supplies (4+Prosperity uses
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.evenMoreSuppliesUse1" {{checked system.inventoryChecks.evenMoreSuppliesUse1}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.evenMoreSuppliesUse2" {{checked system.inventoryChecks.evenMoreSuppliesUse2}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.evenMoreSuppliesUse3" {{checked system.inventoryChecks.evenMoreSuppliesUse3}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.evenMoreSuppliesUse4" {{checked system.inventoryChecks.evenMoreSuppliesUse4}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.evenMoreSuppliesUse5" {{checked system.inventoryChecks.evenMoreSuppliesUse5}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.evenMoreSuppliesUse6" {{checked system.inventoryChecks.evenMoreSuppliesUse6}}>)
          </label>

          <p>Use supplies to Recover, Make Camp, or have extra small items.</p>

          <hr>

          <div class="inventory-two-col">

            <div>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.messKit" {{checked system.inventoryChecks.messKit}}> Mess kit (requires fire & water; makes Supplies last longer)</label>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.bedroll" {{checked system.inventoryChecks.bedroll}}> Bedroll (recover 1d6 extra HP when you Make Camp)</label>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.blanket" {{checked system.inventoryChecks.blanket}}> Blanket (warm)</label>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.rope" {{checked system.inventoryChecks.rope}}> Rope, ~25 ft</label>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.sledge" {{checked system.inventoryChecks.sledge}}> Sledge/litter/travois, roll-out</label>
            </div>

            <div>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.changeClothes" {{checked system.inventoryChecks.changeClothes}}> Change of clothes</label>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.shovel" {{checked system.inventoryChecks.shovel}}> Shovel</label>
              <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.snowShoes" {{checked system.inventoryChecks.snowShoes}}> Snow-shoes</label>
            </div>

          </div>

          <hr>

          <label class="inventory-line diamond-check"><input type="checkbox" name="system.inventoryChecks.torch" {{checked system.inventoryChecks.torch}}> Torch (lasts ~1 hour; reach, area, dangerous)</label>

          <label class="inventory-line diamond-check">
            <input type="checkbox" name="system.inventoryChecks.oilLamp" {{checked system.inventoryChecks.oilLamp}}>
            Oil lamp (
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.oilLampUse1" {{checked system.inventoryChecks.oilLampUse1}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.oilLampUse2" {{checked system.inventoryChecks.oilLampUse2}}>
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.oilLampUse3" {{checked system.inventoryChecks.oilLampUse3}}>
            hours, close, area, crude)
          </label>

          <label class="inventory-line diamond-check">
            <input type="checkbox" name="system.inventoryChecks.extraOil" {{checked system.inventoryChecks.extraOil}}>
            Extra oil (
            <input type="checkbox" class="circle-check" name="system.inventoryChecks.extraOilUse1" {{checked system.inventoryChecks.extraOilUse1}}>
