          <section class="playbook-column">

            {{#each this.rightColumn}}

              <div class="playbook-panel {{#if this.isMove}}move-card insert-move-card{{/if}} {{#if this.isArcana}}arcana-card insert-arcana-card{{/if}} {{#if this.isNpc}}insert-npc-card{{/if}}" data-item-id="{{this.id}}" data-uuid="{{this.uuid}}">
                <div class="playbook-panel-header {{#if this.isArcana}}arcana-card-header{{/if}}">

                  {{#if this.isMove}}
                    <div class="move-header-left">
                      <img class="move-item-icon" src="{{this.img}}" alt="{{this.name}}">

                      <button class="move-title" type="button">
                        {{this.name}}
                      </button>
                    </div>

                    <div class="move-card-actions">
                      <button class="move-edit insert-move-edit icon-button" type="button" title="Edit">
                        <img src="systems/stonetop/assets/icons/edit-icon.png">
                      </button>

                      <button class="move-delete insert-move-delete icon-button" type="button" title="Delete">
                        <img src="systems/stonetop/assets/icons/delete-icon.png">
                      </button>
                    </div>
                  {{else}}
                    {{#if this.isArcana}}
                      <div class="arcana-header-left">
                        <img class="arcana-item-icon" src="{{this.img}}" alt="{{this.name}}">

                        <button class="insert-arcana-title arcana-title" type="button">
                          {{this.name}}
                        </button>
                      </div>

                      <div class="arcana-card-actions">
                        {{#if this.canFlip}}
                          <button class="insert-arcana-flip icon-button" type="button" title="Flip Card">↺</button>
                        {{/if}}

                        <button class="insert-arcana-edit icon-button" type="button" title="Edit">
                          <img src="systems/stonetop/assets/icons/edit-icon.png">
                        </button>

                        <button class="insert-arcana-delete icon-button" type="button" title="Delete">
                          <img src="systems/stonetop/assets/icons/delete-icon.png">
                        </button>
                      </div>
                    {{else}}
                      {{#if this.isNpc}}
                        <section class="npc-top-grid insert-npc-title">

                          <div class="npc-portrait-frame npc-portrait-display">
                            <img src="{{this.img}}" alt="{{this.name}}">
                          </div>

                          <div class="npc-identity-block">

                            <div class="npc-name-frame">
                              <input type="text" value="{{this.name}}" disabled>
                            </div>

                            <input
                              class="npc-tags-field"
                              type="text"
                              value="{{this.system.tags}}"
                              placeholder="Tags"
                              disabled
                            >

                            <div class="npc-loyalty-row">
                              <span>Loyalty</span>

                              <div class="npc-loyalty-pips">
                                {{#each this.loyaltyPips}}
                                  <input
                                    type="checkbox"
                                    class="circle-check npc-loyalty-pip insert-npc-loyalty-pip"
                                    data-value="{{this.value}}"
                                    {{#if this.checked}}checked{{/if}}
                                  >
                                {{/each}}
                              </div>
                            </div>

                          </div>

                        </section>
                      {{else}}
                        {{#if this.isTextBox}}
                          {{#if this.showHeaderCheckbox}}
                            <div class="text-box-title-row">
                              <input
                                type="checkbox"
                                class="square-description-check text-box-header-check"
                                data-item-id="{{this.id}}"
                                {{#if this.headerCheckboxChecked}}checked{{/if}}
                              >
                              <h2>{{this.name}}</h2>
                            </div>
                          {{else}}
                            <h2>{{this.name}}</h2>
                          {{/if}}
                        {{else}}
                          <h2>{{this.name}}</h2>
                        {{/if}}
                      {{/if}}
                    {{/if}}
                  {{/if}}

                </div>

                <div class="playbook-panel-divider"></div>

                <div class="playbook-panel-body {{#if this.isMove}}move-card-body{{/if}} {{#if this.isArcana}}arcana-card-body{{/if}}">

                  {{#if this.isNpc}}

                    <div class="npc-card-sheet insert-npc-card-sheet">

                      <section class="npc-resource-row">

                        <div class="npc-resource npc-damage-resource">
                          <button class="npc-damage-roll insert-npc-damage-roll" type="button">Damage</button>
                          <input type="text" value="{{this.system.damage}}" disabled>
                        </div>

                        <div class="npc-resource npc-armor-resource">
                          <label>Armor</label>
                          <input class="insert-npc-field" data-field="system.armor" type="number" step="1" value="{{this.system.armor}}">
                        </div>

                        <div class="npc-resource npc-hp-resource">
                          <label>HP</label>

                          <div class="npc-split-field">
                            <input class="insert-npc-field" data-field="system.hp.value" type="number" step="1" value="{{this.system.hp.value}}">
                            <span>/</span>
                            <input class="insert-npc-field" data-field="system.hp.max" type="number" step="1" value="{{this.system.hp.max}}">
                          </div>

                          <div class="npc-minmax-labels">
                            <span>Min</span>
                            <span>Max</span>
                          </div>
                        </div>

                      </section>

                      <input
                        class="npc-weapon-field"
                        type="text"
                        value="{{this.system.weapon}}"
                        placeholder="Weapon"
                        disabled
                      >

                      <section class="npc-text-panel">
                        <label>Instincts</label>
                        <div class="playbook-text profile-text-rendered">{{{this.instinctHtml}}}</div>
                      </section>

                      <section class="npc-text-panel">
                        <label>Cost</label>
                        <div class="playbook-text profile-text-rendered">{{{this.costHtml}}}</div>
                      </section>

                      <section class="npc-text-panel">
                        <label>Description</label>
                        <div class="playbook-text profile-text-rendered">{{{this.npcDescriptionHtml}}}</div>
                      </section>

                    </div>

                  {{else}}

                    {{#if this.isArcana}}
                      <div class="arcana-face-label">
                        {{#if this.isBack}}Back{{else}}Front{{/if}}
                      </div>
                    {{/if}}

                    <div class="playbook-text {{#if this.isMove}}move-description{{/if}} {{#if this.isArcana}}arcana-description{{/if}}">
                      {{{this.descriptionHtml}}}
                    </div>

                  {{#if this.isMove}}

                    {{#if this.canRoll}}
                      <label>Roll Stat</label>

                      <select class="move-stat-select insert-move-stat-select">
                        <option value="">No Stat / +Nothing</option>
                        <option value="str" {{#if (eq this.system.stat "str")}}selected{{/if}}>STR</option>
                        <option value="dex" {{#if (eq this.system.stat "dex")}}selected{{/if}}>DEX</option>
                        <option value="con" {{#if (eq this.system.stat "con")}}selected{{/if}}>CON</option>
                        <option value="int" {{#if (eq this.system.stat "int")}}selected{{/if}}>INT</option>
                        <option value="wis" {{#if (eq this.system.stat "wis")}}selected{{/if}}>WIS</option>
                        <option value="cha" {{#if (eq this.system.stat "cha")}}selected{{/if}}>CHA</option>
                      </select>

                      <button class="move-roll insert-move-roll" type="button">Roll</button>
                    {{else}}
                      <button class="move-roll insert-move-roll" type="button">Share</button>
                    {{/if}}

                  {{/if}}

                  {{#if this.isArcana}}

                    {{#if this.canRoll}}
                      <label>Roll Stat</label>

                      <select class="arcana-stat-select insert-arcana-stat-select">
                        <option value="">No Stat / +Nothing</option>
                        <option value="str" {{#if (eq this.system.stat "str")}}selected{{/if}}>STR</option>
                        <option value="dex" {{#if (eq this.system.stat "dex")}}selected{{/if}}>DEX</option>
                        <option value="con" {{#if (eq this.system.stat "con")}}selected{{/if}}>CON</option>
                        <option value="int" {{#if (eq this.system.stat "int")}}selected{{/if}}>INT</option>
                        <option value="wis" {{#if (eq this.system.stat "wis")}}selected{{/if}}>WIS</option>
                        <option value="cha" {{#if (eq this.system.stat "cha")}}selected{{/if}}>CHA</option>
                      </select>

                      <button class="arcana-roll insert-arcana-roll" type="button">Roll</button>
                    {{else}}
                      <button class="arcana-roll insert-arcana-roll" type="button">Share</button>
                    {{/if}}

                  {{/if}}

                  {{/if}}

                </div>
              </div>

            {{else}}

              <div class="playbook-panel">
                <div class="playbook-panel-header">
                  <h2>Right Column</h2>
                </div>

                <div class="playbook-panel-divider"></div>

                <div class="playbook-panel-body">
                  <p>No entries.</p>
                </div>
              </div>

            {{/each}}

          </section>

        </div>

      </div>

    {{/each}}

  </section>

</form>